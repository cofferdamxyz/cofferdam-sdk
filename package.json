{
  "name": "cofferdam-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @cofferdam/sdk and @cofferdam/sdk-react. Published packages live under packages/. See README.md.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && yarn workspace @cofferdam/example-capacitor-minimal typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "ethers": "^6.13.0",
    "react": "^19.2.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "zksync-ethers": "^6.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}
