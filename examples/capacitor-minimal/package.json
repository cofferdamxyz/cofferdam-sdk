{
  "name": "@cofferdam/example-capacitor-minimal",
  "private": true,
  "version": "0.0.0",
  "description": "Minimal Capacitor + React example demonstrating @cofferdam/sdk-react. Smallest possible integration: provider + drop-in button + session display.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local-chain": "VITE_COFFERDAM_NETWORK=local-chain vite",
    "dev:sepolia-testnet": "VITE_COFFERDAM_NETWORK=sepolia-testnet vite",
    "tail": "node scripts/tail-chain.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@cofferdam/sdk": "*",
    "@cofferdam/sdk-react": "*",
    "ethers": "^6.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zksync-ethers": "^6.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
