# Build output
dist/
*.tsbuildinfo

# Capacitor native projects — generated by `cap add`. Real consumer apps
# should commit ios/ and android/ to source control. We deliberately do NOT
# commit them in this example because (a) they're hundreds of files, (b) they
# bake in absolute paths from the machine that ran `cap add`, and (c) any
# developer running this example will run `cap add` themselves.
ios/
android/

# Dependency lock file lives at the workspace root, not here.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Editor
.vscode/
.idea/
.DS_Store

# Env
.env
.env.local
