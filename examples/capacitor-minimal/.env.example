# ─────────────────────────────────────────────────────────────────────────────
# Network mode
# ─────────────────────────────────────────────────────────────────────────────
# `mock`            : in-process MockProvider, no chain, no backend (α-1 default).
# `local-chain`     : real LocalChainProvider against base-anvil. Sign-in
#                     binds the user's deterministic EOA on
#                     `CofferdamReceiver`, and the demo exposes buttons to
#                     fire real escrow txs against the local node.
#                     Reads VITE_LOCAL_* keys (below). See README §6.
# `sepolia-testnet` : same UI + flow as local-chain, pointed at Base
#                     Sepolia public testnet (chainId 84532). Uses scaled-down
#                     demo amounts (~100× smaller) and clickable block-
#                     explorer links on every tx. Reads VITE_TESTNET_* keys
#                     (below). See README §6 "Switching to Base Sepolia".
# `native-aa`       : real NativeAccountProvider against the native Base
#                     AA stack on base-anvil. Sign-in derives a High-tier
#                     P-256 passkey + the CofferdamSmartAccount's counterfactual
#                     address; the account deploys via the factory and transacts
#                     gaslessly through the CofferdamPaymaster. Reads VITE_NATIVE_*.
# `native-aa-testnet`: same as native-aa, pointed at Base Sepolia
#                     (chainId 84532). Reads VITE_NATIVE_* with testnet addresses
#                     and a funded VITE_NATIVE_ADMIN_PRIVATE_KEY (no default).
VITE_COFFERDAM_NETWORK=mock

# ─────────────────────────────────────────────────────────────────────────────
# Mock-profile selector (only used when VITE_COFFERDAM_NETWORK=mock)
# ─────────────────────────────────────────────────────────────────────────────
# Selects which named fixture from the SDK's mockProfiles registry powers the
# in-process MockProvider. See cofferdam-sdk/README.md §4.8 for the full list.
# Valid values:
#   verified-br   (default) verified BR user, 18+, OFAC-clear, fresh proof
#   verified-us             verified US user, 21+, OFAC-clear, fresh proof
#   unverified              user with no Self proof yet
#   ofac-flagged            verified user with ofacClear=false
#   stale-proof             verified user with proof > 90 days old
VITE_COFFERDAM_MOCK_PROFILE=verified-br

# ─────────────────────────────────────────────────────────────────────────────
# Local-chain config (only used when VITE_COFFERDAM_NETWORK=local-chain)
# ─────────────────────────────────────────────────────────────────────────────
# RPC endpoint of your base-anvil node.
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_LOCAL_CHAIN_ID=31337

# Deployed Base contract addresses. Get these from the output of
#   cd base-contracts && yarn deploy:local
# or from base-contracts/deployments/inMemoryNode.json after a deploy.
VITE_LOCAL_RECEIVER_ADDRESS=
VITE_LOCAL_ESCROW_ADDRESS=
VITE_LOCAL_FACTORY_ADDRESS=

# anvil rich wallet #0 — bound-identity admin in α-2 (stands in for the
# future α-3 LayerZero DVN delivery / v2 Cofferdam TEE attestation). NEVER use
# this key for real funds. It's hard-coded in anvil's default
# configuration, fully public.
VITE_LOCAL_ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Stable per-role identifiers. Different values produce different deterministic
# EOAs (HMAC(seed, id)), so changing these gives you "fresh users" without
# restarting the node.
VITE_LOCAL_RECRUITER_ID=local-recruiter-1
VITE_LOCAL_FUNDER_ID=local-finance-1
VITE_LOCAL_WORKER_ID=local-worker-1

# ─────────────────────────────────────────────────────────────────────────────
# Sepolia-testnet config (only used when VITE_COFFERDAM_NETWORK=sepolia-testnet)
# ─────────────────────────────────────────────────────────────────────────────
# Same provider as local-chain, just pointed at the public Base Sepolia
# testnet. The demo uses a separate VITE_TESTNET_* env namespace so you can
# keep both local-chain and sepolia-testnet configs side-by-side in this file
# without mutating the same keys.
#
# Receiver/Factory/Escrow addresses come from your Base Sepolia deploy —
# see base-contracts/deployments/baseSepolia.json after running
#   cd base-contracts
#   yarn deploy:all:sepolia        # auth + Self + NullifierRegistry (receiver)
#   yarn deploy:escrow:sepolia     # MockUSDC + EscrowFactory + sample escrow
# Mapping:
#   VITE_TESTNET_RECEIVER_ADDRESS = NullifierRegistry
#   VITE_TESTNET_FACTORY_ADDRESS  = EscrowFactory
#   VITE_TESTNET_ESCROW_ADDRESS   = CofferdamSpotEscrow (sample)
#
# RPC + chain ID also have sane defaults; override if you have a private
# RPC that's faster than the public endpoint.
#
# VITE_TESTNET_ADMIN_PRIVATE_KEY has NO default (unlike local mode, which
# falls back to anvil's public rich wallet). It must be a funded Base Sepolia
# EOA. On sign-in the provider uses it only to pre-fund each role's derived
# wallet with ETH (a plain transfer — it does NOT bind identity on-chain in
# the PoC). Reuse the same testing wallet as the ZKSync docs
# (0x2c8A01e971d7C51B3B78f9F08c57c45584D96AB2) — it can be the same key as
# the contracts deployer. One full 4-role demo run costs ~0.03 testnet ETH.
# Top it up via any no-signup faucet (no Coinbase acct needed):
#   https://www.ethereum-ecosystem.com/faucets/base-sepolia  (pk910 PoW, ≤0.5 ETH/24h)
#   https://bwarelabs.com/faucets/base-sepolia
#   https://ethfaucet.com/
# (CDP faucet also works when you have a Coinbase account.)
#
# DO NOT COMMIT `.env.local` once VITE_TESTNET_ADMIN_PRIVATE_KEY is filled in.
# `.env.example` stays committed because it has no secrets.

# Optional overrides (defaults shown):
# VITE_TESTNET_RPC_URL=https://sepolia.base.org
# VITE_TESTNET_CHAIN_ID=84532
# VITE_TESTNET_RECEIVER_ADDRESS=
# VITE_TESTNET_ESCROW_ADDRESS=
# VITE_TESTNET_FACTORY_ADDRESS=

# Required (no default):
VITE_TESTNET_ADMIN_PRIVATE_KEY=

# Per-role identifiers. Different from local mode's defaults so the same
# .env.local can carry both configs without their deterministic EOAs
# colliding. (Local: local-recruiter-1 etc. → distinct addresses from
# Sepolia: sepolia-recruiter-1 etc.)
VITE_TESTNET_RECRUITER_ID=sepolia-recruiter-1
VITE_TESTNET_FUNDER_ID=sepolia-finance-1
VITE_TESTNET_WORKER_ID=sepolia-worker-1

# Tail script auto-detects the network from VITE_COFFERDAM_NETWORK; with
# `sepolia-testnet` it reads VITE_TESTNET_* and points at the Sepolia RPC.
# (Sepolia is busy, so `tail --backfill=0` is the typical mode.)

# ─────────────────────────────────────────────────────────────────────────────
# Native-AA config (used when VITE_COFFERDAM_NETWORK=native-aa[-testnet])
# ─────────────────────────────────────────────────────────────────────────────
# Drives the NativeAccountProvider: a P-256 passkey-governed CofferdamSmartAccount
# derived counterfactually, deployed via the factory, and transacting gaslessly
# through the paymaster.
#
# Deploy the stack first:
#   cd ../../../base-contracts
#   yarn anvil                             # persistent anvil on :8545
#   yarn deploy:auth:local                 # PasskeyAuthority + session modules
#   yarn deploy:native:local               # factory + paymaster
# then copy the three addresses from base-contracts/deployments/inMemoryNode.json:
#   PasskeyAuthority.address       → VITE_NATIVE_PASSKEY_MODULE_ADDRESS
#   CofferdamAccountFactory.address→ VITE_NATIVE_FACTORY_ADDRESS
#   CofferdamPaymaster.address     → VITE_NATIVE_PAYMASTER_ADDRESS
#
# Defaults: local RPC :8545, chainId 31337, and anvil's public rich wallet #0 as
# the admin/deployer key (deploys the account + funds the paymaster). For
# native-aa-testnet, set chainId 84532, a Base Sepolia RPC, the Sepolia addresses, and
# a FUNDED admin key (no default — anvil's key is local-only).
VITE_NATIVE_RPC_URL=http://127.0.0.1:8545
VITE_NATIVE_CHAIN_ID=31337
VITE_NATIVE_FACTORY_ADDRESS=
VITE_NATIVE_PAYMASTER_ADDRESS=
VITE_NATIVE_PASSKEY_MODULE_ADDRESS=
VITE_NATIVE_ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Stable per-user id → deterministic passkey + counterfactual address. Change it
# for a "fresh user" (new account address) without restarting the node.
VITE_NATIVE_USER_ID=local-native-1
