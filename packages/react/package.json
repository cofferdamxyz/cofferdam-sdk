{
  "name": "@cofferdam/sdk-react",
  "version": "0.0.0",
  "description": "React bindings for @cofferdam/sdk — CofferdamProvider, useSignInWithCofferdam, SignInWithCofferdamButton.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OffshoreSync/cofferdam-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/OffshoreSync/cofferdam-sdk#readme",
  "bugs": {
    "url": "https://github.com/OffshoreSync/cofferdam-sdk/issues"
  },
  "peerDependencies": {
    "@cofferdam/sdk": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "keywords": [
    "cofferdam",
    "offshoresync",
    "react",
    "identity",
    "sign-in"
  ]
}
