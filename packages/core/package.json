{
  "name": "@cofferdam/sdk",
  "version": "0.0.0",
  "description": "Sign in with Cofferdam — verified-identity, ZK-proof, on-chain-signing primitive for any app. Framework-agnostic core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/providers/MockProvider.d.ts",
      "import": "./dist/providers/MockProvider.js"
    },
    "./local": {
      "types": "./dist/providers/LocalChainProvider.d.ts",
      "import": "./dist/providers/LocalChainProvider.js"
    },
    "./native": {
      "types": "./dist/providers/NativeAccountProvider.d.ts",
      "import": "./dist/providers/NativeAccountProvider.js"
    },
    "./escrow": {
      "types": "./dist/escrow/CofferdamSpotEscrowClient.d.ts",
      "import": "./dist/escrow/CofferdamSpotEscrowClient.js"
    }
  },
  "dependencies": {
    "@noble/curves": "^1.2.0"
  },
  "peerDependencies": {
    "ethers": "^6.13.0",
    "zksync-ethers": "^6.15.0"
  },
  "peerDependenciesMeta": {
    "ethers": { "optional": true },
    "zksync-ethers": { "optional": true }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OffshoreSync/cofferdam-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/OffshoreSync/cofferdam-sdk#readme",
  "bugs": {
    "url": "https://github.com/OffshoreSync/cofferdam-sdk/issues"
  },
  "keywords": [
    "cofferdam",
    "offshoresync",
    "identity",
    "wallet",
    "web3",
    "zksync",
    "celo",
    "self-protocol",
    "passport",
    "zk"
  ]
}
